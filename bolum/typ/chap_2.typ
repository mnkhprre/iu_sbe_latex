#heading(level: 2)[Araştırma Bulgularının Sınıflandırılması]



    
    // SBE Kuralları uyarınca Tablo Nesnesi (Temizlenmiş ve Verileri Eksiksiz Girişmiş Hali)
#figure(
  caption: [Araştırmada İncelenen Değişkenlerin Dağılımı],
  table(
    columns: (1fr, 1fr, 1fr),     // 3 adet eşit genişlikte sütun
    align: (left, center, right), // sırasıyla sola, ortaya ve sağa yasla
    stroke: 0.5pt,                // çizgi kalınlığı
    
    table.hline(),
    [*Kategori*], [*Örneklem Sayısı (N)*], [*Oran (%)*],
    table.hline(),
    [Birinci Grup], [120], [40,0],
    [İkinci Grup], [50,0],
    [Üçüncü Grup],  [10,0],
    table.hline(),
    [*Toplam*],     [*300*], [*100,0*],
    table.hline(),
  )
) <tab_degiskenler>

  // Çapraz referans için etiket
@tab_degiskenler incelendiğinde, örneklem gruplarının oransal dağılımı görülmektedir. Tablo ve şekillerin numaralandırılmasında Arap veya Romen rakamları tutarlı biçimde kullanılır (Madde 3/b).

#heading(level: 2)[Kurumsal Yapı ve Karşılaştırmalı Değerlendirme]



// SBE Kuralları uyarınca Şekil/Grafik Nesnesi (\framebox karşılığı yer tutucu kutu ile)
#figure(
  caption: [Araştırma Modeli ve Değişkenler Arası Etkileşim],
  rect(
    width: 75%,
    height: 4cm,
    stroke: 0.5pt,
    radius: 0pt,
    align(center + horizon)[Şekil / Grafik Alanı]
  )
) <fig_model> // Çapraz referans için etiket

Şekil @fig_model'de görüldüğü üzere modelin kavramsal boyutları birbiriyle bütüncül bir etkileşim içerisindedir. Şekil ve tablo listeleri ön kısımda tek satır aralığı ile yer almaktadır (Madde 4/b).
